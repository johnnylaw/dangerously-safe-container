# Copy to .env and fill in your values. .env is gitignored.

# Required
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: pin a specific model
# CLAUDE_MODEL=claude-opus-4-6

# Optional: proxy or custom API endpoint
# ANTHROPIC_BASE_URL=https://my-proxy.example.com

# Optional: resource limits (defaults: 4 CPUs, 4 GB RAM)
# CLAUDE_CPUS=2.0
# CLAUDE_MEMORY=2g

# Optional: suppress color (useful in CI)
# NO_COLOR=1
